# Secret key used for JWT signing
SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# Allowed origins for CORS (comma-separated).
# Wildcard matching for *.vercel.app is already enabled by default.
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Token expiration time in minutes (default: 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480
